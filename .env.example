# Local Luxe Concierge PWA — environment configuration
#
# DEMO MODE: Leave these blank and the app runs fully on seeded, in-browser data
# (no backend needed). Perfect for presenting. To go live, create a Firebase
# project, paste the web-app config values below, and rename this file to `.env`.
#
# Firebase console → Project settings → General → "Your apps" → Web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloud Messaging (push) — Project settings → Cloud Messaging → Web Push certificates
VITE_FIREBASE_VAPID_KEY=
